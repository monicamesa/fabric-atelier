# Copy to .private/values.env (ignored by Git) and fill in. Never commit the real values.
# Microsoft Entra tenant ID (GUID), from `npx rayfin login status`.
TENANT_ID=
# ID of the FabricApp-AgentJury workspace, from the Fabric portal URL (/groups/<id>/).
WORKSPACE_ID_AGENT_JURY=
# ID of the FabricApp-AgentJury-Demo workspace; leave empty until it exists.
WORKSPACE_ID_AGENT_JURY_DEMO=
# Rayfin item ID (AppBackend) of agent-jury, from `npx rayfin up status`.
APP_BACKEND_ID_AGENT_JURY=
# Fabric capacity ID, from `npx rayfin up status`.
CAPACITY_ID=
# Account used to sign in to Fabric.
ACCOUNT_EMAIL=
# Personal email that must never appear in commits.
PERSONAL_EMAIL=
# Deployed app URL ("Static app" in `npx rayfin up status`).
APP_URL_AGENT_JURY=
# Windows user folder, for example the value of $env:USERPROFILE.
WINDOWS_USER_PATH=
# Server FQDN of the agent-jury app SQL database; written by apps/agent-jury/scripts/find-app-sql-database.mjs.
APP_SQL_SERVER_AGENT_JURY=
# Database name of the agent-jury app SQL database; written by the same script.
APP_SQL_DATABASE_AGENT_JURY=
# Test deployment of agent-jury (FabricApp-AgentJury-Test workspace), where the deployed checks run.
# `node scripts/deploy-test.mjs` deploys there, writes apps/agent-jury/rayfin/.env.test (git-ignored) and switches
# back to production. The check scripts default to .env.test and refuse the production item (APP_BACKEND_ID_AGENT_JURY).
WORKSPACE_ID_AGENT_JURY_TEST=
# Written by `node scripts/find-app-sql-database.mjs --target=test`.
APP_SQL_SERVER_AGENT_JURY_TEST=
APP_SQL_DATABASE_AGENT_JURY_TEST=
# Optional, agent-jury. Leave empty. Only for a deployment whose admin log has automated-check rows from before
# the checks marked their requests: ISO UTC time (for example 2026-01-31T12:00:00Z) before which log rows count as
# automated checks. Push it to the Function with:
#   (Select-String -Path ..\..\.private\values.env -Pattern '^LEGACY_CHECK_CUTOFF_UTC=(.+)$').Matches[0].Groups[1].Value | npx rayfin secret set LEGACY_CHECK_CUTOFF_UTC --stdin
LEGACY_CHECK_CUTOFF_UTC=
