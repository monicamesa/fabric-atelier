# Copy to .private/values.env (ignored by Git) and fill in. Never commit the real values.
# Microsoft Entra tenant ID (GUID), from `npx rayfin login status`.
TENANT_ID=
# ID of the FabricApp-AgentJury workspace, from the Fabric portal URL (/groups/<id>/).
WORKSPACE_ID_AGENT_JURY=
# ID of the FabricApp-AgentJury-Demo workspace; leave empty until it exists.
WORKSPACE_ID_AGENT_JURY_DEMO=
# Rayfin item ID (AppBackend) of agent-jury, from `npx rayfin up status`.
APP_BACKEND_ID_AGENT_JURY=
# Fabric capacity ID, from `npx rayfin up status`.
CAPACITY_ID=
# Account used to sign in to Fabric.
ACCOUNT_EMAIL=
# Personal email that must never appear in commits.
PERSONAL_EMAIL=
# Deployed app URL ("Static app" in `npx rayfin up status`).
APP_URL_AGENT_JURY=
# Windows user folder, for example the value of $env:USERPROFILE.
WINDOWS_USER_PATH=
# Server FQDN of the agent-jury app SQL database; written by apps/agent-jury/scripts/find-app-sql-database.mjs.
APP_SQL_SERVER_AGENT_JURY=
# Database name of the agent-jury app SQL database; written by the same script.
APP_SQL_DATABASE_AGENT_JURY=
